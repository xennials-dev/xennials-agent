# ============================================================================
# Xennials AI Playground — Environment Variables
# ============================================================================
# Copy this file to .env.playground and fill in your API keys.
# Only keys for providers you want to use are required — leave others blank.
#
#   cp .env.playground.example .env.playground
#
# Then start the stack:
#   docker compose -f docker-compose.ai.yml --env-file .env.playground up -d
# ============================================================================

# ── LiteLLM Gateway ────────────────────────────────────────────────────────
# Master key for authenticating frontend requests to the proxy.
# Change this to a secure random string in production.
LITELLM_MASTER_KEY=sk-xennials-playground-dev-key

# ── Cloud Open-Weights Providers ───────────────────────────────────────────
# Free tiers available for all of these. Sign up at their respective sites.

# Groq — Ultra-fast inference (https://console.groq.com/keys)
GROQ_API_KEY=

# Together AI — Large model hosting (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# DeepInfra — Cost-effective inference (https://deepinfra.com/dash/api_keys)
DEEPINFRA_API_KEY=

# OpenRouter — Multi-provider aggregator (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ── Media Generation ──────────────────────────────────────────────────────
# fal.ai — Image/Video/Audio generation (https://fal.ai/dashboard/keys)
FAL_KEY=

# ── Frontend Dev Server ───────────────────────────────────────────────────
# URL your playground.html uses to reach the LiteLLM proxy
VITE_LITELLM_BASE_URL=http://localhost:4000/v1
VITE_LITELLM_API_KEY=sk-xennials-playground-dev-key
