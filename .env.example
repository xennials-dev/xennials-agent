# Hermes Agent Web Dashboard - Environment Variables
# Copy to .env.local for local overrides or configure in Netlify Environment Variables

# Backend server endpoint URL (default: http://127.0.0.1:9119)
# Use this when running web dashboard standalone on Netlify or remote hosting
HERMES_DASHBOARD_URL=http://127.0.0.1:9119

# Vite client-side backend URL
VITE_HERMES_BACKEND_URL=http://127.0.0.1:9119

# Vite dev server port
PORT=5173
